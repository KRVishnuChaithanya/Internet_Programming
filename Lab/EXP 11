function viewProperty(){

    alert("Property Details Opened!");

}


function saveProperty(){

    alert("Property Added to Favourites!");

}


function scheduleViewing(){

    alert("Property Viewing Scheduled Successfully!");

}


function calculateMortgage(){

    var amount =
        parseFloat(document.getElementById("loanAmount").value);

    var rate =
        parseFloat(document.getElementById("interestRate").value);

    var years =
        parseFloat(document.getElementById("loanYears").value);

    if(isNaN(amount) || isNaN(rate) || isNaN(years)){

        alert("Please enter all loan details.");

        return;

    }

    var monthlyRate = rate / 12 / 100;

    var months = years * 12;

    var emi =
        (amount * monthlyRate *
        Math.pow(1 + monthlyRate, months)) /
        (Math.pow(1 + monthlyRate, months) - 1);

    document.getElementById("emiResult").innerHTML =
        "<b>Monthly EMI: ₹" + emi.toFixed(2) + "</b>";

}


function searchAgent(){

    alert("Agent / Company Search Completed!");

}


function updateProperty(){

    alert("Property Details Updated!");

}


function deleteProperty(){

