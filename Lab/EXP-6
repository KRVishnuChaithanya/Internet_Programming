<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Online Cake Ordering System</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#fff6f8;
}

header{
background:#ff4d6d;
color:white;
padding:20px;
text-align:center;
}

header h1{
font-size:34px;
}

header p{
margin-top:10px;
}

nav{
display:flex;
justify-content:center;
flex-wrap:wrap;
background:#ff758f;
}

nav button{
padding:15px 18px;
border:none;
background:none;
color:white;
font-size:16px;
cursor:pointer;
transition:.3s;
}

nav button:hover{
background:#d90452;
}

section{
display:none;
padding:30px;
animation:fade .5s;
}

.active{
display:block;
}

@keyframes fade{

from{
opacity:0;
}

to{
opacity:1;
}

}

.banner{
background:white;
padding:40px;
border-radius:10px;
text-align:center;
box-shadow:0 0 10px lightgray;
}

.banner h2{
color:#d90452;
margin-bottom:20px;
}

.banner p{
font-size:18px;
line-height:28px;
}

.banner button{
margin-top:20px;
padding:12px 25px;
background:#ff4d6d;
color:white;
border:none;
border-radius:5px;
font-size:18px;
cursor:pointer;
}

.banner button:hover{
background:#d90452;
}

.cards{
display:flex;
justify-content:space-around;
flex-wrap:wrap;
margin-top:30px;
}

.card{
width:280px;
background:white;
margin:15px;
padding:20px;
border-radius:10px;
box-shadow:0 0 10px gray;
text-align:center;
}

.card img{
width:100%;
height:180px;
border-radius:10px;
}

.card h3{
margin:15px 0;
color:#d90452;
}

.card p{
line-height:25px;
}

.card button{
margin-top:15px;
padding:10px 20px;
background:#ff4d6d;
color:white;
border:none;
cursor:pointer;
border-radius:5px;
}

.card button:hover{
background:#d90452;
}

form{
width:450px;
margin:auto;
background:white;
padding:30px;
border-radius:10px;
box-shadow:0 0 10px gray;
}

form h2{
text-align:center;
margin-bottom:20px;
color:#d90452;
}

input,
select,
textarea{
width:100%;
padding:12px;
margin:10px 0;
border:1px solid gray;
border-radius:5px;
}

input[type=button]{
background:#ff4d6d;
color:white;
border:none;
cursor:pointer;
}

input[type=button]:hover{
background:#d90452;
}

table{
width:100%;
border-collapse:collapse;
background:white;
margin-top:20px;
}

table th{
background:#ff4d6d;
color:white;
padding:12px;
}

table td{
border:1px solid gray;
padding:12px;
text-align:center;
}

footer{
background:#ff4d6d;
color:white;
text-align:center;
padding:20px;
margin-top:40px;
}

</style>

</head>

<body>

<header>

<h1>ONLINE CAKE ORDERING SYSTEM</h1>

<p>Fresh Cakes Delivered To Your Doorstep</p>

</header>

<nav>

<button onclick="showSection('home')">Home</button>

<button onclick="showSection('register')">Register</button>

<button onclick="showSection('login')">Login</button>

<button onclick="showSection('cakes')">Browse Cakes</button>

<button onclick="showSection('details')">Cake Details</button>

<button onclick="showSection('cart')">Cart</button>

<button onclick="showSection('delivery')">Delivery</button>

<button onclick="showSection('payment')">Payment</button>

<button onclick="showSection('tracking')">Track Order</button>

<button onclick="showSection('admin')">Admin</button>

</nav>

<!-- HOME -->

<section id="home" class="active">

<div class="banner">

<h2>Welcome To Cake World</h2>

<p>

Choose from hundreds of delicious cakes for every occasion.
Customize your cake with your favourite flavour, size and
personal message.

</p>

<button onclick="showSection('cakes')">

Order Now

</button>

</div>

<div class="cards">

<div class="card">

<img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587">

<h3>Birthday Cakes</h3>

<p>

Chocolate, Vanilla, Strawberry and Black Forest Cakes.

</p>

<button onclick="showSection('cakes')">

View Cakes

</button>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1464306076886-da185f6a9d05">

<h3>Wedding Cakes</h3>

<p>

Premium multi-layer wedding cakes with custom designs.

</p>

<button onclick="showSection('cakes')">

View Cakes

</button>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1488477181946-6428a0291777">

<h3>Special Occasion Cakes</h3>

<p>

Anniversary, Graduation and Celebration Cakes.

</p>

<button onclick="showSection('cakes')">

View Cakes

</button>

</div>

</div>

</section>

<!-- REGISTER -->

<section id="register">

<form>

<h2>User Registration</h2>

<input type="text" placeholder="Full Name">

<input type="email" placeholder="Email Address">

<input type="tel" placeholder="Mobile Number">

<input type="password" placeholder="Password">

<input type="password" placeholder="Confirm Password">

<input
type="button"
value="Register"
onclick="alert('Registration Successful')">

</form>

</section>

<!-- LOGIN -->

<section id="login">

<form>

<h2>User Login</h2>

<input
type="text"
id="username"
placeholder="Username">

<input
type="password"
id="password"
placeholder="Password">

<input
type="button"
value="Login"
onclick="loginUser()">

</form>

</section>

<!-- BROWSE CAKES -->

<section id="cakes">

<div class="cards">

<div class="card">

<img src="https://images.unsplash.com/photo-1565958011703-44f9829ba187">

<h3>Chocolate Cake</h3>

<p>

Flavor : Chocolate<br>

Weight : 1 Kg<br>

Price : $25

</p>

<button onclick="showSection('details')">

View Details

</button>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1533134242443-d4fd215305ad">

<h3>Red Velvet Cake</h3>

<p>

Flavor : Red Velvet<br>

Weight : 1 Kg<br>

Price : $30

</p>

<button onclick="showSection('details')">

View Details

</button>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1621303837174-89787a7d4729">

<h3>Black Forest Cake</h3>

<p>

Flavor : Black Forest<br>

Weight : 1 Kg<br>

Price : $28

</p>

<button onclick="showSection('details')">

View Details

</button>

</div>

</div>

</section>
<!-- CAKE DETAILS -->

<section id="details">

<form>

<h2>Cake Details</h2>

<select>

<option>Select Cake</option>
<option>Chocolate Cake</option>
<option>Black Forest Cake</option>
<option>Red Velvet Cake</option>
<option>Vanilla Cake</option>
<option>Butterscotch Cake</option>

</select>

<select>

<option>Select Size</option>
<option>500 g</option>
<option>1 Kg</option>
<option>2 Kg</option>
<option>3 Kg</option>

</select>

<input
type="text"
placeholder="Cake Flavour">

<input
type="text"
placeholder="Message On Cake">

<textarea
rows="4"
placeholder="Special Instructions"></textarea>

<input
type="button"
value="Add To Cart"
onclick="addCart()">

</form>

</section>

<!-- CART -->

<section id="cart">

<h2 align="center">Shopping Cart</h2>

<table>

<tr>

<th>Product</th>
<th>Quantity</th>
<th>Price</th>
<th>Total</th>

</tr>

<tr>

<td>Chocolate Cake</td>
<td>1</td>
<td>$25</td>
<td>$25</td>

</tr>

<tr>

<td>Red Velvet Cake</td>
<td>2</td>
<td>$30</td>
<td>$60</td>

</tr>

<tr>

<td colspan="3"><b>Grand Total</b></td>

<td><b>$85</b></td>

</tr>

</table>

<br>

<center>

<input
type="button"
value="Proceed To Delivery"
onclick="showSection('delivery')">

</center>

</section>

<!-- DELIVERY DETAILS -->

<section id="delivery">

<form>

<h2>Delivery Details</h2>

<input
type="text"
placeholder="Customer Name">

<input
type="tel"
placeholder="Mobile Number">

<textarea
rows="4"
placeholder="Delivery Address"></textarea>

<input
type="date">

<select>

<option>Morning</option>
<option>Afternoon</option>
<option>Evening</option>

</select>

<input
type="button"
value="Continue To Payment"
onclick="showSection('payment')">

</form>

</section>

<!-- PAYMENT -->

<section id="payment">

<form>

<h2>Payment</h2>

<input
type="text"
placeholder="Card Holder Name">

<input
type="text"
placeholder="Card Number">

<input
type="month">

<input
type="password"
placeholder="CVV">

<select>

<option>Credit Card</option>
<option>Debit Card</option>
<option>UPI</option>
<option>Net Banking</option>

</select>

<input
type="button"
value="Pay Now"
onclick="paymentSuccess()">

</form>

</section>

<!-- ORDER TRACKING -->

<section id="tracking">

<h2 align="center">Order Tracking</h2>

<table>

<tr>

<th>Order ID</th>
<th>Cake</th>
<th>Status</th>
<th>Expected Delivery</th>

</tr>

<tr>

<td>CK1001</td>
<td>Chocolate Cake</td>
<td>Preparing</td>
<td>Today 5:00 PM</td>

</tr>

<tr>

<td>CK1002</td>
<td>Black Forest Cake</td>
<td>Out For Delivery</td>
<td>Today 7:00 PM</td>

</tr>

<tr>

<td>CK1003</td>
<td>Red Velvet Cake</td>
<td>Delivered</td>
<td>Completed</td>

</tr>

</table>

</section>

<!-- ADMIN PANEL -->

<section id="admin">

<h2 align="center">Admin Dashboard</h2>

<div class="cards">

<div class="card">

<h3>Total Cakes</h3>

<h1>120</h1>

</div>

<div class="card">

<h3>Total Orders</h3>

<h1>540</h1>

</div>

<div class="card">

<h3>Customers</h3>

<h1>385</h1>

</div>

<div class="card">

<h3>Revenue</h3>

<h1>$15,800</h1>

</div>

</div>

</section>
<footer>

<h3>Online Cake Ordering System</h3>

<p>Fresh Cakes | Fast Delivery | Secure Payment</p>

<p>© 2026 Cake World. All Rights Reserved.</p>

</footer>

<script>

function showSection(id){

let sections=document.querySelectorAll("section");

for(let i=0;i<sections.length;i++){

sections[i].classList.remove("active");

}

document.getElementById(id).classList.add("active");

}

function loginUser(){

let user=document.getElementById("username").value;

let pass=document.getElementById("password").value;

if(user=="admin" && pass=="admin123"){

alert("Administrator Login Successful");

showSection("admin");

}

else if(user=="user" && pass=="user123"){

alert("Login Successful");

showSection("cakes");

}

else{

alert("Invalid Username or Password");

}

}

function addCart(){

alert("Cake Added To Cart Successfully");

showSection("cart");

}

function paymentSuccess(){

alert("Payment Successful!\n\nYour Order Has Been Placed Successfully.");

showSection("tracking");

}

window.onload=function(){

showSection("home");

}

</script>

</body>

</html>
